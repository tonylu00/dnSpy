  {
   "Id": "m0153:0x06003321",
   "ProposedName": "StartCommunicationAsync",
   "Reason": "Opens the HID device, honors discovery timing, queries SupportedEmiType with one retry, restores a still-supported active EMI type, records the open time, and starts the receive task. Failure closes communication before rethrowing.",
