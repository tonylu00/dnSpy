<UserControl x:Class="ConnectorFixture.View" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <UserControl.Resources>
    <Style x:Key="StyledButton" TargetType="Button"><EventSetter Event="Click" Handler="OnStyledClick" /></Style>
  </UserControl.Resources>
  <StackPanel><Button x:Name="Direct" Click="OnClick" /><Button x:Name="Styled" Style="{StaticResource StyledButton}" /></StackPanel>
</UserControl>
