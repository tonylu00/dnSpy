<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RuntimeDirectory Condition="'$(RuntimeDirectory)' == ''">$(MSBuildThisFileDirectory)..\..\dnSpy\dnSpy\bin\Release\net10.0-windows</RuntimeDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="dnlib"><HintPath>$(RuntimeDirectory)\dnlib.dll</HintPath></Reference>
  </ItemGroup>
</Project>
